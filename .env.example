# ─────────────────────────────────────────────────────────────
# CSS Visual — environment template. Copy to server/.env (server)
# and client/.env.local (client) and fill in real values.
# Placeholders only — NEVER commit real credentials.
# ─────────────────────────────────────────────────────────────

# Server
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-access-secret
JWT_REFRESH_SECRET=replace-me-refresh-secret
COOKIE_SECRET=replace-me-cookie-secret

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/css-visual
# Optional separate URI for integration tests (falls back to MONGODB_URI minus db name + "-test")
MONGODB_URI_TEST=

# AI tutor provider — leave AI_PROVIDER unset to disable the tutor gracefully.
# Supported: openai | openai-compatible | none
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_DAILY_QUOTA_GUEST=5
AI_DAILY_QUOTA_FREE=20
AI_DAILY_QUOTA_PRO=200
AI_DAILY_QUOTA_ADMIN=500
AI_TIMEZONE=UTC

# Payments — PAYMENT_PROVIDER: stripe | razorpay | none (none = config-required state on /billing)
PAYMENT_PROVIDER=none
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email (SMTP). Leave unset to log verification/reset emails to the server console in development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="CSS Visual <no-reply@cssvisual.app>"

# Platform
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
